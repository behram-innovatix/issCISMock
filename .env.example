# HMAC secret for the signed CIS session cookie (set a long random value outside local dev)
SESSION_SECRET=change-me

# Where the dashboards and Connections read from: "mock" (default: generated in the browser, no backend;
# what the Vercel preview runs) or "api" (the CIS API below). Build-time: restart dev / rebuild after changing it.
NEXT_PUBLIC_DATA_SOURCE=mock

# CIS API (Herd/issCisApi), used when NEXT_PUBLIC_DATA_SOURCE=api: every dashboard reads its data from it, and Administration → Connections manages it.
# Server-only: never prefix with NEXT_PUBLIC_.
# Token: run `php artisan cis:token` in issCisApi and put the value in .env.local.
CIS_API_URL=http://isscisapi.test
CIS_API_TOKEN=
